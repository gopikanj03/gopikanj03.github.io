# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Model used to phrase answers. llama-3.1-8b-instant and llama-3.3-70b-versatile
# currently return 404 on this account; switch back once they are enabled.
GROQ_MODEL=qwen/qwen3.8-27b

# Seconds to wait for Groq before answering from retrieval alone.
GROQ_TIMEOUT=30
